# VoiceShield AI - Backend Environment Configuration

# Server Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Twilio Programmable Voice Credentials (Optional for cloud provider media streaming)
# Get credentials at https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Public WebSocket URL for external Twilio Webhook (e.g., wss://your-domain.ngrok-free.app/ws/telecom/media-stream)
TWILIO_STREAM_WS_URL=
