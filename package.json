{
  "name": "voiceshield-ai-platform",
  "version": "1.0.0",
  "private": true,
  "description": "VoiceShield AI - Real-time Voice Impersonation Defense Command Center",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "backend": "python -m uvicorn backend.app.main:app --host 127.0.0.1 --port 8000 --reload --reload-dir backend --reload-dir AI",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "test": "python scripts/run_all_tests.py",
    "train": "python AI/training/train.py",
    "evaluate": "python AI/evaluation/evaluate.py",
    "check-lines": "python scripts/check_line_counts.py",
    "preview": "npm --prefix frontend run preview"
  }
}
